{
  "manifest_version": 3,
  "name": "Smart Email Summarizer and Priority Analyzer",
  "version": "1.0.0",
  "description": "Summarize emails, extract key points, detect action items, analyze priority, identify tone, and suggest quick replies.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Email Summarizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
